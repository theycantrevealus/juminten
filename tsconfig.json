{
  "compilerOptions": {
    "types": [
      "vitest/globals",
      "node"
    ],
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "noEmit": false,
    "target": "es2020",
    "sourceMap": true,
    "outDir": "./dist",
    "noLib": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "incremental": true,
    "paths": {
      "@configuration/*": [
        "./apps/configuration/*"
      ],
      "@database/*": [
        "./apps/libs/infrastructure/database/*"
      ],
      "@decorator/*": [
        "./apps/decorator/*"
      ],
      "@filter/*": [
        "./apps/filter/*"
      ],
      "@guard/*": [
        "./apps/guard/*"
      ],
      "@integration/*": [
        "./apps/integration/*"
      ],
      "@interceptor/*": [
        "./apps/interceptor/*"
      ],
      "@module/*": [
        "./apps/libs/module/*"
      ],
      "@shared/*": [
        "./apps/libs/shared/*"
      ],
      "@util/*": [
        "./apps/util/*"
      ]
    },
    "baseUrl": "./"
  },
  "include": [
    "./apps/**/*.ts",
    "./libs/**/*.ts",
    "./k6/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}